# 复制为 .env 后按实际情况修改（.env 不要提交到代码仓库）

# 服务端镜像版本，和 build-image.sh 的版本号一致
LEDGER_VERSION=1.0.0
# 服务器公网 IP（以后有备案域名可以换成域名）
LEDGER_HOST=1.2.3.4
# 对外端口，记得在云厂商安全组放行
LEDGER_PORT=8443
# Caddy 官方镜像，固定具体版本
CADDY_IMAGE=caddy:2.11.7-alpine

LEDGER_TZ=Asia/Shanghai
# 这台服务器最多允许注册几个账号
LEDGER_MAX_USERS=2

# ---- 华为 Push Kit（鸿蒙推送），没配置时鸿蒙只在打开 App 时看到提醒 ----
HUAWEI_PROJECT_ID=
# 方式一：项目级 OAuth 客户端
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
# 方式二：服务账号密钥文件（放在 deploy/secrets/ 目录下）
HUAWEI_SERVICE_ACCOUNT_FILE=
HUAWEI_PUSH_CATEGORY=MARKETING
HUAWEI_PUSH_TEST_MESSAGE=true
